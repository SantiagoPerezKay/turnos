# Base de datos (en Easypanel: host interno del servicio Postgres, p.ej. <proyecto>_postgres)
DATABASE_URL=postgresql+asyncpg://agendador:agendador@localhost:5432/agendador

# Clave para la API de administración (header X-API-Key). Generá una larga y aleatoria.
ADMIN_API_KEY=cambiar-esto
# Firma de las sesiones del panel. Generá una larga y aleatoria.
JWT_SECRET=cambiar-esto-tambien
# URL(s) del panel web, separadas por coma
CORS_ORIGINS=http://localhost:5173

# WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp)
WHATSAPP_API_VERSION=v24.0
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Número de prueba (referencia; el phone_number_id real de cada negocio va en la base)
WHATSAPP_WABA_ID=
WHATSAPP_NUMERO=

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
CLAUDE_FALLBACKS=true

# Recordatorios (requiere plantilla aprobada en Meta)
RECORDATORIOS_ACTIVOS=true
RECORDATORIO_HORAS_ANTES=24
RECORDATORIO_TEMPLATE=recordatorio_turno
RECORDATORIO_TEMPLATE_IDIOMA=es_AR

LOG_LEVEL=INFO
